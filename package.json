{
  "name": "hollowmere",
  "productName": "Hollowmere",
  "version": "0.7.6",
  "description": "Hollowmere: The Sunken Wells - an original action RPG dungeon crawler",
  "main": "electron/main.js",
  "author": "Hollowmere",
  "license": "UNLICENSED",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --outfile=app/game.js",
    "dev": "esbuild src/main.js --bundle --format=iife --sourcemap --outfile=app/game.js",
    "start": "npm run build && electron .",
    "dist": "npm run pack && makensis installer/hollowmere.nsi",
    "pack": "npm run build && electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.hollowmere.game",
    "productName": "Hollowmere",
    "files": [
      "electron/**",
      "app/**",
      "!app/preview.html",
      "!app/preview.js",
      "!app/game.js.map",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "icon": "installer/icon.ico"
    }
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "three": "^0.170.0"
  }
}